  "components": {
    "schemas": {
      "AccountDto": {
        "required": [
          "userId",
          "name",
          "email",
          "role",
          "shopId",
          "shopName",
          "shopTimeZone"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "shopId": {
            "type": "string",
            "format": "uuid"
          },
          "shopName": {
            "type": "string"
          },
          "shopTimeZone": {
            "type": "string"
          }
        }
      },
      "AddPackagingRequest": {
        "required": [
          "barcode",
          "name",
          "conversionFactor"
        ],
        "type": "object",
        "properties": {
          "barcode": {
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "conversionFactor": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "AddStaffRequest": {
        "required": [
          "name",
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "AuthResponse": {
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "account"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "account": {
            "$ref": "#/components/schemas/AccountDto"
          }
        }
      },
      "CategoryDto": {
        "required": [
          "id",
          "name",
          "parentId",
          "depth",
          "active"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "parentId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "depth": {
            "type": "integer",
            "format": "int32"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "CategoryTreeNode": {
        "required": [
          "id",
          "name",
          "depth",
          "active",
          "children"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "depth": {
            "type": "integer",
            "format": "int32"
          },
          "active": {
            "type": "boolean"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryTreeNode"
            }
          }
        }
      },
      "CreateCategoryRequest": {
        "required": [
          "name",
          "parentId"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "parentId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "CreateProductRequest": {
        "required": [
          "name",
          "categoryId",
          "barcode",
          "salePriceCents"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "barcode": {
            "type": "string"
          },
          "salePriceCents": {
            "type": "integer",
            "format": "int64"
          },
          "baseUnit": {
            "$ref": "#/components/schemas/UnitOfMeasure"
          },
          "minimumStock": {
            "type": "integer",
            "format": "int32",
            "default": 0
          },
          "tracksExpiry": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "MoveCategoryRequest": {
        "required": [
          "parentId"
        ],
        "type": "object",
        "properties": {
          "parentId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "PackagingDto": {
        "required": [
          "id",
          "gtin",
          "displayGtin",
          "name",
          "conversionFactor",
          "isDefault",
          "isInternalCode"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "gtin": {
            "type": "string"
          },
          "displayGtin": {
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "conversionFactor": {
            "type": "integer",
            "format": "int32"
          },
          "isDefault": {
            "type": "boolean"
          },
          "isInternalCode": {
            "type": "boolean"
          }
        }
      },
      "ProductDto": {
        "required": [
          "id",
          "name",
          "categoryId",
          "baseUnit",
          "salePriceCents",
          "averageCostCents",
          "minimumStock",
          "tracksExpiry",
          "active",
          "packagings",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "baseUnit": {
            "$ref": "#/components/schemas/UnitOfMeasure"
          },
          "salePriceCents": {
            "type": "integer",
            "format": "int64"
          },
          "averageCostCents": {
            "type": "integer",
            "format": "int64"
          },
          "minimumStock": {
            "type": "integer",
            "format": "int32"
          },
          "tracksExpiry": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          },
          "packagings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PackagingDto"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RenameCategoryRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "SignInRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "SignUpRequest": {
        "required": [
          "shopName",
          "ownerName",
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "shopName": {
            "type": "string"
          },
          "ownerName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "timeZone": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TeamMemberDto": {
        "required": [
          "id",
          "name",
          "email",
          "role",
          "active",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "active": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UnitOfMeasure": {
        "enum": [
          "Unit",
          "Kilogram",
          "Liter"
        ]
      },
      "UpdateProductRequest": {
        "required": [
          "name",
          "categoryId",
          "salePriceCents",
          "minimumStock",
          "tracksExpiry"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "salePriceCents": {
            "type": "integer",
            "format": "int64"
