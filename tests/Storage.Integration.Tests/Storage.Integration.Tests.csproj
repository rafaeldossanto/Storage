<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- TEMPORARY: the SQLite integration tests were removed with the move to MongoDB, and
         the Mongo ones need a replica set to run against. Until they land, an empty run
         (exit code 8) must not fail `dotnet test`. Remove this line with the first test. -->
    <TestingPlatformCommandLineArguments>--ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Storage.Infrastructure\Storage.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Storage.Api\Storage.Api.csproj" />
  </ItemGroup>

</Project>
